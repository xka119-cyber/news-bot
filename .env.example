# 이 파일에는 키 이름만 적습니다. 실제 값은 .env 파일에 넣으세요.
ANTHROPIC_API_KEY=
IG_ACCESS_TOKEN=
IG_USER_ID=
TELEGRAM_BOT_TOKEN=
# 아래 값은 나중에 채웁니다. TELEGRAM_CHAT_ID는 M4, GH_PAT은 선택 사항입니다.
TELEGRAM_CHAT_ID=
GH_PAT=
# 시계(Cloudflare Worker, clock/)가 GitHub Actions를 깨울 때 쓰는 토큰 (2026-11-06).
# GitHub fine-grained 토큰: news-bot 저장소만, Repository permissions → Actions: Read and write.
# 여기 넣은 뒤 `python scripts/set_clock_secrets.py`가 Cloudflare 비밀값으로 옮깁니다 (RUNBOOK '시계').
GH_DISPATCH_TOKEN=

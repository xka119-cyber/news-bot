{% extends "_base.html.j2" %}
{# 시안 A: 깔끔한 카드 — 흰 바탕, 남색 머리띠, 노란 해석 상자 #}
{% block style %}
body { background: var(--bg); }
.card { width: 100%; height: 100%; display: flex; flex-direction: column; }

/* 표지 */
.cover-top { background: var(--primary); color: #fff; padding: 80px 80px 70px; height: 760px; display: flex; flex-direction: column; }
.brand { display: inline-block; align-self: flex-start; background: var(--accent); color: var(--primary); font-weight: 800; font-size: 34px; padding: 12px 26px; border-radius: 999px; }
.date { margin-top: 36px; font-size: 38px; font-weight: 600; opacity: .8; }
.hook { margin-top: auto; font-size: calc(var(--s) * 92px); font-weight: 800; line-height: 1.22; letter-spacing: -2px; }
.hook-line { width: 160px; height: 12px; background: var(--accent); margin-top: 34px; border-radius: 6px; }
.cover-list { flex: 1; padding: 60px 80px 0; display: flex; flex-direction: column; gap: 30px; }
.cover-list li { list-style: none; display: flex; align-items: center; gap: 26px; font-size: calc(var(--s) * 44px); font-weight: 700; color: var(--primary); }
.num { flex: none; width: 64px; height: 64px; border-radius: 50%; background: var(--accent); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 34px; font-weight: 800; }
.swipe { padding: 0 80px 70px; font-size: 30px; color: #8A93A6; font-weight: 600; text-align: right; }

/* 뉴스 */
.top { height: 150px; padding: 0 80px; background: var(--primary); display: flex; align-items: center; justify-content: space-between; }
.chip { background: var(--accent); color: var(--primary); font-size: 36px; font-weight: 800; padding: 12px 28px; border-radius: 999px; }
.count { color: #fff; font-size: 36px; font-weight: 700; opacity: .85; }
.main { flex: 1; padding: 40px 80px; display: flex; flex-direction: column; justify-content: center; }
.headline { font-size: calc(var(--s) * 70px); font-weight: 800; color: var(--primary); line-height: 1.25; letter-spacing: -1.5px; }
.rule { width: 100%; height: 4px; background: #E7EAF0; margin: 44px 0 40px; }
.lines li { list-style: none; position: relative; padding-left: 40px; font-size: calc(var(--s) * 42px); line-height: 1.5; margin-bottom: 34px; font-weight: 600; }
.lines li::before { content: ""; position: absolute; left: 4px; top: 0.62em; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); }
.why { margin-top: 40px; background: #FFF4D1; border-left: 12px solid var(--accent); border-radius: 20px; padding: 32px 38px; }
.why-label { font-size: calc(var(--s) * 32px); font-weight: 800; color: var(--primary); margin-bottom: 12px; }
.why-text { font-size: calc(var(--s) * 40px); font-weight: 700; line-height: 1.4; color: var(--text); }
.foot { height: 110px; padding: 0 80px; border-top: 3px solid #EEF0F4; display: flex; align-items: center; justify-content: space-between; font-size: 26px; color: #6B7385; font-weight: 600; }
.foot b { color: var(--primary); }
{% endblock %}
{% block body %}
<div class="card">
{% if card.kind == "cover" %}
  <div class="cover-top fit-box">
    <span class="brand">{{ brand }}</span>
    <div class="date">{{ card.date }}</div>
    <div class="hook">{{ card.hook }}</div>
    <div class="hook-line"></div>
  </div>
  <ul class="cover-list fit-box">
    {% for h in card.headlines %}<li><span class="num">{{ loop.index }}</span><span>{{ h }}</span></li>{% endfor %}
  </ul>
  <div class="swipe">옆으로 넘겨 보세요 →</div>
{% else %}
  <div class="top"><span class="chip"><span class="emoji">{{ card.emoji }}</span> {{ card.category }}</span><span class="count">{{ card.number }} / {{ card.count }}</span></div>
  <div class="main fit-box">
    <div class="headline">{{ card.headline }}</div>
    <div class="rule"></div>
    <ul class="lines">{% for line in card.summary_lines %}<li>{{ line }}</li>{% endfor %}</ul>
    <div class="why"><div class="why-label"><span class="emoji">💡</span> 그래서 나한테는</div><div class="why-text">{{ card.why_it_matters }}</div></div>
  </div>
  <div class="foot"><span>출처 · <b>{{ card.source_name }}</b></span><span>{{ brand }} · {{ card.page }}/{{ card.total }}</span></div>
{% endif %}
</div>
{% endblock %}

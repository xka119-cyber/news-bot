{% extends "_base.html.j2" %}
{# 스티커 노트 (2026-11-04 선택): 크림 바탕·손글씨 스티커·메모지, 반듯하게. 1게시물 1뉴스 4장 #}
{% block style %}
body { background: #FFFBF1; }
.card { width: 100%; height: 100%; padding: 80px; display: flex; flex-direction: column; position: relative; }
.top { display: flex; justify-content: space-between; align-items: center; }
.sticker { background: var(--accent); color: var(--primary); font-family: "Pen"; font-size: 54px; padding: 4px 30px 8px; border-radius: 22px; }
.page { font-family: "Jua"; font-size: 34px; color: #8A8F9C; }
mark { background: linear-gradient(transparent 60%, var(--accent) 60%, var(--accent) 92%, transparent 92%); color: inherit; }
.foot { margin-top: 30px; display: flex; justify-content: space-between; gap: 30px; font-size: 26px; color: #6B7385; font-weight: 600; }
.foot .ctx { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* 1장: 표지 */
.cover-body { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.date { font-family: "Pen"; font-size: 56px; color: #5B6475; }
.cat { margin-top: 30px; display: flex; align-items: center; gap: 18px; font-family: "Jua"; font-size: 44px; color: var(--primary); }
.cat .emoji { font-size: 76px; }
.cover-title { margin-top: 26px; font-family: "Jua"; font-size: calc(var(--s) * 122px); line-height: 1.2; color: var(--primary); }
.cover-sub { margin-top: 40px; font-size: calc(var(--s) * 46px); font-weight: 600; line-height: 1.4; color: #3B4560; }
.swipe { font-family: "Pen"; font-size: 54px; color: var(--primary); text-align: right; }

/* 2~3장: 핵심 */
.point-body { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.point-title { font-family: "Jua"; font-size: calc(var(--s) * 92px); line-height: 1.2; color: var(--primary); }
.paper { margin-top: 56px; background: #fff; border-radius: 30px; padding: 56px 54px 30px; box-shadow: 0 6px 0 rgba(31,42,68,.08); position: relative; }
.paper::before { content: ""; position: absolute; top: -16px; left: 50%; width: 140px; height: 32px; margin-left: -70px; background: rgba(255,200,61,.8); border-radius: 4px; }
.paper li { list-style: none; font-size: calc(var(--s) * 46px); line-height: 1.45; font-weight: 600; margin-bottom: 30px; padding-left: 48px; position: relative; }
.paper li::before { content: ""; position: absolute; left: 4px; top: .55em; width: 20px; height: 20px; border-radius: 50%; background: var(--accent); }

/* 4장: 나한테 의미 */
.why-body { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.why { background: var(--primary); color: #fff; border-radius: 34px; padding: 64px 60px; }
.why-label { font-family: "Pen"; font-size: calc(var(--s) * 70px); color: var(--accent); }
.why-text { margin-top: 18px; font-size: calc(var(--s) * 56px); font-weight: 700; line-height: 1.45; }
.save { margin-top: 50px; font-family: "Pen"; font-size: 56px; color: var(--primary); text-align: center; }
{% endblock %}
{% block body %}
<div class="card">
  <div class="top">
    {% if card.kind == "cover" %}<span class="sticker">{{ brand }}</span>
    {% elif card.kind == "point" %}<span class="sticker"><span class="emoji">{{ card.emoji }}</span> {{ card.category }} · {{ card.page - 1 }}/2</span>
    {% else %}<span class="sticker">한 줄 정리</span>{% endif %}
    <span class="page">{{ card.page }}/{{ card.total }}</span>
  </div>

{% if card.kind == "cover" %}
  <div class="cover-body fit-box">
    <div class="date">{{ card.date }}</div>
    <div class="cat"><span class="emoji">{{ card.emoji }}</span>{{ card.category }}</div>
    <div class="cover-title"><mark>{{ card.cover_title }}</mark></div>
    <div class="cover-sub">{{ card.sub }}</div>
  </div>
  <div class="swipe">옆으로 넘겨 보세요 →</div>
  <div class="foot"><span>출처 · {{ card.source_name }}</span><span>{{ brand }}</span></div>

{% elif card.kind == "point" %}
  <div class="point-body fit-box">
    <div class="point-title"><mark>{{ card.title }}</mark></div>
    <ul class="paper">{% for line in card.lines %}<li>{{ line }}</li>{% endfor %}</ul>
  </div>
  <div class="foot"><span class="ctx">{{ card.cover_title }}</span><span>출처 · {{ card.source_name }}</span></div>

{% else %}
  <div class="why-body fit-box">
    <div class="why"><div class="why-label">그래서 나한테는?</div><div class="why-text">{{ card.text }}</div></div>
    <div class="save">저장해 두고 필요할 때 꺼내 보세요</div>
  </div>
  <div class="foot"><span>출처 · {{ card.source_name }}</span><span>{{ brand }}</span></div>
{% endif %}
</div>
{% endblock %}
